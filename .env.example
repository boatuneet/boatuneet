# Supabase — Project Settings > API keys.
# Both are server-only: no NEXT_PUBLIC_ prefix, so Next never ships them to
# the browser. The page talks to Supabase only from server code.
# Copy to .env.local (gitignored) and fill in.
SUPABASE_URL=https://<project-ref>.supabase.co

# The `sb_secret_...` key ("secret", formerly service_role). Never commit it,
# never expose it to the browser. In production set it as a deployment secret.
SUPABASE_SECRET_KEY=
